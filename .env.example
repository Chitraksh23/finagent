# At least one LLM key is required (all free tiers). Providers are tried in this order.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional model overrides (free model IDs change; pin and re-check them)
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# SEC asks for a descriptive User-Agent with contact info
SEC_USER_AGENT="FinAgent your-name your-email@example.com"

# Public-demo guard: max questions per IP per 10 minutes (best effort)
RATE_LIMIT_PER_10MIN=8
